{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@react-shimeji/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/react/src/**/*.ts",
    "packages/react/src/**/*.tsx",
    "vitest.config.ts"
  ]
}
